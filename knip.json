  "entry": ["src/app/**/*.{ts,tsx}", "tests/**/*.ts", "scripts/**/*.mjs"],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "scripts/**/*.mjs"],
  "ignore": [
