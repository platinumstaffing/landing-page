{
  "name": "platinum-staffing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm validate:env && next build",
    "start": "next start",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{js,mjs}\" \".github/**/*.{yml,yaml}\" \"*.{js,mjs,ts,json,yml,yaml}\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{js,mjs}\" \".github/**/*.{yml,yaml}\" \"*.{js,mjs,ts,json,yml,yaml}\" \"README.md\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=chromium",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "security:secrets": "secretlint \"**/*\"",
    "security:audit": "pnpm audit --prod --audit-level high",
    "deps:check": "knip --include files,dependencies",
    "validate:env": "node scripts/validate-environment.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm deps:check && pnpm build",
    "ci": "pnpm verify && pnpm test:smoke",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.3",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "resend": "^6.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "secretlint": "13.0.4",
    "shadcn": "4.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
