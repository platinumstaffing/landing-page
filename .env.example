# Platinum Staffing & Recruitment — environment variables
# Copy to .env.local for local development. Never commit real secrets.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set only in Vercel. The deployment build fails closed when this is
# "staging" or "production" and a required value below is missing.
DEPLOYMENT_TARGET=""

# Used by Playwright, Lighthouse, and deployment verification.
E2E_BASE_URL="http://127.0.0.1:3000"

# --- Form delivery (Resend) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender address (must be on a domain verified in Resend)
CONTACT_FROM_EMAIL="website@platinumstaffing.example"
# Internal inbox that should receive employer inquiries / applications
CONTACT_TO_EMAIL="hello@platinumstaffing.example"

# --- Resume uploads (Vercel Blob) ---
# Provisioned automatically on Vercel; set locally for testing uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Spam protection (Cloudflare Turnstile) ---
# Optional locally; required for staging and production builds.
# When both are set, forms verify a Turnstile token server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional: lets automation test a Vercel deployment protected by Vercel Auth.
# Store the real value as an environment-scoped GitHub secret, never here.
VERCEL_AUTOMATION_BYPASS_SECRET=""
